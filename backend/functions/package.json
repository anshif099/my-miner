{
  "name": "@miner/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run --exclude tests/database.rules.test.ts",
    "test:rules": "vitest run tests/database.rules.test.ts"
  },
  "dependencies": {
    "@miner/shared": "0.1.0",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.3.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/node": "24.12.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.11"
  }
}
