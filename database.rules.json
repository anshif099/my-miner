{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId && !data.exists() && newData.child('userId').val() === auth.uid",
        ".validate": "newData.hasChildren(['userId', 'email', 'displayName', 'timezone', 'createdAt', 'updatedAt'])"
      }
    },
    "devices": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "deviceCommands": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId", "deviceId", "status"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "miningSessions": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId", "deviceId"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "earnings": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId", "timestamp"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "wallets": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "schedules": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "settings": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId && data.child('ownerId').val() === auth.uid",
        ".write": "auth != null && auth.uid === $userId && newData.child('ownerId').val() === auth.uid",
        ".validate": "newData.hasChildren(['ownerId', 'timezone', 'electricityPriceINRPerKWh', 'telemetryIntervalSeconds', 'backendTimeoutSeconds', 'maxSessionDurationMinutes', 'maxGpuTemperatureC', 'maxCpuTemperatureC', 'minBatteryPercent', 'chargingRequired', 'updatedAt'])"
      }
    },
    "auditLogs": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId", "serverTimestamp"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "profitabilitySnapshots": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "telemetryLive": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId", "deviceId"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "telemetryRollups": {
      ".read": "auth != null && query.orderByChild === 'ownerId' && query.equalTo === auth.uid",
      ".indexOn": ["ownerId", "deviceId", "intervalEnd"],
      "$id": { ".read": "auth != null && data.child('ownerId').val() === auth.uid", ".write": false }
    },
    "pairingCodes": { ".read": false, ".write": false },
    "deviceCommandCounters": { ".read": false, ".write": false }
  }
}